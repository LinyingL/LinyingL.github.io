---
import { Image } from 'astro:assets';
import type { Post } from '../utils/posts';
import { formatDate, getCategoryMeta, extractFirstImage } from '../utils/posts';

interface Props { post: Post }
const { post } = Astro.props;
const cat = getCategoryMeta(post.data.category);
const kicker = post.data.kicker ?? cat?.kicker ?? 'Latest';
const accent = cat?.accent;

// Priority: explicit frontmatter `cover` (Astro-optimised) →
// first image found in article body (scraped at build time) →
// empty gradient placeholder.
const cover = post.data.cover;
const autoCover = !cover ? extractFirstImage(post.body ?? '') : undefined;
const hasCover = !!cover || !!autoCover;
---

<section class="hero">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__text">
        <div class="kicker" style={accent ? `color:${accent}` : undefined}>{kicker}</div>
        <h1 class="hero__title">
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </h1>
        {post.data.description && (
          <p class="hero__lede">{post.data.description}</p>
        )}
        <div class="hero__meta">
          <strong>{post.data.author ?? ''}</strong>
          {post.data.author ? ' · ' : ''}
          {formatDate(post.data.pubDate)}
        </div>
      </div>
      <div class={`hero__cover${hasCover ? '' : ' hero__cover--empty'}`}>
        {cover && (
          <Image
            src={cover}
            alt={post.data.coverAlt ?? ''}
            widths={[480, 768, 1024]}
            sizes="(max-width: 820px) 100vw, 520px"
          />
        )}
        {!cover && autoCover && (
          <img
            src={autoCover}
            alt={post.data.coverAlt ?? ''}
            loading="lazy"
          />
        )}
      </div>
    </div>
  </div>
</section>
