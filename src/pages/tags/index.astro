---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, tagSlug } from '../../utils/posts';

const counts = await getAllTags();
const tags = [...counts.entries()].sort((a, b) =>
  b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<BaseLayout title="Tags" description="Browse by topic tag.">
  <div class="container">
    <header class="page-head">
      <div class="kicker">Tags</div>
      <h1>Tags</h1>
      <p>{tags.length} {tags.length === 1 ? 'tag' : 'tags'} across the archive.</p>
    </header>

    {tags.length > 0 ? (
      <div class="tagcloud">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${tagSlug(tag)}/`}>
            #{tag} <span class="count">{count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="muted">No tags yet.</p>
    )}
  </div>
</BaseLayout>
