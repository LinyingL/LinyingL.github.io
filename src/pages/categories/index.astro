---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../utils/posts';
import { CATEGORIES } from '../../config';

const all = await getAllPosts();
const counts = new Map<string, number>();
for (const p of all) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
---

<BaseLayout title="Sections" description="Browse all sections.">
  <div class="container">
    <header class="page-head">
      <div class="kicker">Sections</div>
      <h1>Sections</h1>
      <p>Browse articles by topic.</p>
    </header>

    <ul class="list">
      {CATEGORIES.map((c) => (
        <li class="list__item">
          <span class="list__date">
            {counts.get(c.slug) ?? 0} {counts.get(c.slug) === 1 ? 'article' : 'articles'}
          </span>
          <div>
            <h3 class="list__title">
              <a href={`/categories/${c.slug}/`}>{c.name}</a>
            </h3>
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
